* {
    border: none;
    font-family: "Inter", "JetBrainsMono Nerd Font";
    font-size: 18px;
    min-height: 0;
}

.modules-left,
.modules-center,
.modules-right {
    background: @bg;
    border-radius: 14px;
    padding: 4px 24px;
    margin: 8px 2px;
}

window#waybar {
    background: transparent;
}

#custom-nixos,
#workspaces,
#window,
#network,
#backlight,
#battery,
#pulseaudio,
#clock,
#tray {
    background: transparent;

    color: @text;

    padding: 0 8px;
}

#workspaces button {
    color: @surface2;

    padding: 0 6px;

    transition: 180ms;
}

#workspaces button.active {
    color: @accent;
}

#workspaces button:hover {
    color: @text;
}

#window {
    font-weight: 600;
}

#custom-nixos {
    color: @accent;

    font-size: 18px;
}

#clock {
    color: @green;
}

#battery.warning {
    color: @yellow;
}

#battery.critical {
    color: @red;
}
